        \PYG{n}{l}\PYG{o}{=}\PYG{n}{l}\PYG{o}{\PYGZhy{}}\PYG{p}{(}\PYG{n}{l}\PYG{o}{*}\PYG{p}{(}\PYG{n}{l}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{o}{/}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{o}{*}\PYG{n}{b}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{2}\PYG{p}{))}
