breed [ bubbles bubble ]

bubbles-own [
  base-size
  growing-size
  stuck-on-wall?
  growing-on-wall?
  on-surface?
  survival-factor

  z-speed
  z-acceleration
  x-speed
  x-acceleration
  y-speed
  y-acceleration
]

globals [
  ;; variables for biasing the generation of bubbles
  horizontal-bias
  vertical-bias

  current-percent-pressure

  bubbles-generated-last-step

  count-merges
  count-bounces
]

to setup
  clear-all
  reset-ticks

  ;; transform [0, 1] -> [10, 0.1], essentially map x'->1-x and x''->10^(2x'-1)
  set horizontal-bias (10 ^ ((1 - nucleation-sites-effect) * 2 - 1))
  ;; transform [0, 1] -> [0.1, 10], essentially map x'->10^(2x-1)
  set vertical-bias (10 ^ ((depth-pressure-effect) * 2 - 1))
  ;; transform [0, 1] -> [1, 0.1], essentially map x'->1-x and x''->10^(2x'-1)

  set current-percent-pressure starting-percent-pressure
  if current-percent-pressure = 1 [ set current-percent-pressure 0.9999999999999999 ]
end

to go
  ;; transform [0, 1] -> [10, 0.1], essentially map x'->1-x and x''->10^(2x'-1)
  set horizontal-bias (10 ^ ((1 - nucleation-sites-effect) * 2 - 1))
  ;; transform [0, 1] -> [0.1, 10], essentially map x'->10^(2x-1)
  set vertical-bias (10 ^ ((depth-pressure-effect) * 2 - 1))

  generate-bubbles
  step

  ;; update pressure
  ;; base amount is [10,20] divide by pressure but don't divide by bubbles-bias so that it's effect is shown in the reduction of pressure
  ;; average bubbles created is 15
  let percent-of-average-bubbles-created (bubbles-generated-last-step / (current-percent-pressure * (base-bubbles-creation-rate + 5))) ;; 5 is average of random 10
                                                                                                                                       ;  let percent-of-max-bubbles-created ((bubbles-generated-last-step / current-percent-pressure - 10 ) / 10)

  ;; transform [0, 1] -> [20, 0.05], essentially map x'->1-x and x''->10^(2x'-1)
  let pressure-bias (20 ^ ((pressure-drain-rate) * 2 - 1))

  set current-percent-pressure (current-percent-pressure * (0.99999 - pressure-bias * (0.0001 * percent-of-average-bubbles-created))) ;; follow O(0.9999^x)

  tick
end

to reset-globals
  set dynamic-adhesion-effect 0.68
  set adhesion-effect 0.47
  set depth-pressure-effect 0.81
  set nucleation-sites-effect 0.65
  set starting-percent-pressure 1.0
  set pressure-drain-rate 0.75
  set grow-effect 0.15
  set base-bubbles-creation-rate 30
  set bubble-creation-rate 0.55
  set chance-to-merge 0.73
  set resistance-to-popping 0.5
end

to generate-bubbles
  ;; transform [0, 1] -> [0.1, 10], essentially map x'->1-x and x''->10^(2x'-1)
  let bubbles-bias (10 ^ ((bubble-creation-rate) * 2 - 1))
  set bubbles-generated-last-step ((random-float 10 + base-bubbles-creation-rate) * bubbles-bias * current-percent-pressure)

  create-bubbles bubbles-generated-last-step [
    set shape "circle"

    ;; map a random biased [0,1] float into [-15,15] (not centered)
    set zcor ((random-float 1 ) ^ vertical-bias * (max-pzcor - min-pzcor) + min-pzcor)

    set base-size ((current-percent-pressure * random-float 0.3) + 0.5)
    set size (base-size * 5  * ((zcor + max-pzcor) * grow-effect / (max-pzcor * 2)))
    set color white

    ;; map a random biased [-1, 1] float into [-15,15] (centered around 0)
    ;; roll a biased float to see if bubble will spawn on the walls
    ifelse (random-float 1 ^ horizontal-bias > 0.5) [
      let x-or-y-wall (round random-float 1) ;; 1 if x, 0 if y
      let sign (random 2 * 2 - 1) ;; 1 or -1
      let rand (random-float 1 * (max-pxcor - min-pxcor) + min-pzcor) ;; [min,max] cor (assuming xcors==ycors)

      set xcor (max-pxcor * x-or-y-wall * sign + rand * (1 - x-or-y-wall))
      set ycor (max-pycor * (1 - x-or-y-wall) * sign + rand * x-or-y-wall)
      set growing-on-wall? true
      set stuck-on-wall? true
      set on-surface? false
      set growing-size base-size
    ][
      set xcor random-xcor
      set ycor random-ycor
      set growing-on-wall? false
      set stuck-on-wall? false
      set on-surface? false
      initiate-movement
    ]
  ]
end

to initiate-movement
  ;; for some variety
  let accel-percent random-float 0.2 + 0.6 ;; random float [0.9, 1.1]
  set z-acceleration (current-percent-pressure * accel-percent * ((zcor + max-pzcor) / (max-pzcor * 2)) / 30) ;; 30 ticks/second
  set z-speed (z-speed + z-acceleration)

  set x-acceleration (random-float 0.0001 - 0.00005)
  set x-speed (x-speed + x-acceleration)

  set y-acceleration (random-float 0.0001 - 0.00005)
  set y-speed (y-speed + y-acceleration)

  ;; if free moving, adjust acceleration and speed so that you don't go through the wall, give small boost to get unstuck from wall
  ifelse (not stuck-on-wall? and growing-on-wall?) [ ;; no need to change the other!
    ifelse abs xcor > abs ycor [ ;; if stuck on a x wall
      if xcor > 0 [
        set x-acceleration (random-float 0.01 + 0.01)
        set x-speed (- random-float 0.1 - 0.05)
      ]
      if xcor < 0 [
        set x-acceleration (- random-float 0.01 - 0.01)
        set x-speed (random-float 0.1 + 0.05)
      ]

    ] [ ;; if stuck on a y wall
      if ycor > 0 [
        set y-acceleration (random-float 0.01 + 0.01)
        set y-speed (- random-float 0.1 - 0.05)
      ]
      if ycor < 0 [
        set y-acceleration (- random-float 0.01 - 0.01)
        set y-speed (random-float 0.1 + 0.05)
      ]
    ]

  ] [
    ;; if still stuck on wall, don't give any horizontal movement
    if (stuck-on-wall? and growing-on-wall?) [
      set x-acceleration 0
      set x-speed 0

      set y-acceleration 0
      set y-speed 0
    ]
  ]
  set growing-on-wall? false ;; no longer growing, actively moving instead
end

to initiate-surface-behaviour
  set on-surface? true
  set z-acceleration 0
  set z-speed 0
  set survival-factor 2

end

to resolve-merge
  set count-merges (count-merges + 1)

  let my-size size
  let other-size [size] of myself

  let my-base base-size
  let other-base [base-size] of myself

  let my-xcor xcor
  let other-xcor [xcor] of myself
  let my-ycor ycor
  let other-ycor [ycor] of myself
  let my-zcor xcor
  let other-zcor [zcor] of myself

  let my-x-speed x-speed
  let other-x-speed [x-speed] of myself
  let my-y-speed y-speed
  let other-y-speed [y-speed] of myself
  let my-z-speed z-speed
  let other-z-speed [z-speed] of myself

  let my-x-acceleration x-acceleration
  let other-x-acceleration [x-acceleration] of myself
  let my-y-acceleration y-acceleration
  let other-y-acceleration [y-speed] of myself
  let my-z-acceleration z-acceleration
  let other-z-acceleration [z-acceleration] of myself

  let average-size (my-size + other-size) / 2
  let average-base (my-base + other-base) / 2
  let average-xcor (my-xcor + other-xcor) / 2
  let average-ycor (my-ycor + other-ycor) / 2
  let average-zcor (my-zcor + other-zcor) / 2
  let average-x-speed (my-x-speed + other-x-speed) / 2
  let average-y-speed (my-y-speed + other-y-speed) / 2
  let average-z-speed (my-z-speed + other-z-speed) / 2
  let average-x-acceleration (my-x-acceleration + other-x-acceleration) / 2
  let average-y-acceleration (my-y-acceleration + other-y-acceleration) / 2
  let average-z-acceleration (my-z-acceleration + other-z-acceleration) / 2

  hatch-bubbles 1 [
    set growing-on-wall? false
    set stuck-on-wall? false
    set on-surface? false
    set color white
    set shape "circle"

    set size average-size
    set base-size average-base
    set xcor average-xcor
    set ycor average-ycor
    set zcor average-zcor
    set x-speed average-x-speed
    set y-speed average-y-speed
    set z-speed average-z-speed
    set x-acceleration average-x-acceleration
    set y-acceleration average-y-acceleration
    set z-acceleration average-z-acceleration

  ]

  ask myself [die]
  die
end

to resolve-bounce
  set count-bounces (count-bounces + 1)

  set x-speed (-1 * x-speed)
  set y-speed (-1 * y-speed)
  set x-acceleration (-1 * x-acceleration)
  set y-acceleration (-1 * y-acceleration)

  ask myself [
    set x-speed (-1 * x-speed)
    set y-speed (-1 * y-speed)
    set x-acceleration (-1 * x-acceleration)
    set y-acceleration (-1 * y-acceleration)
  ]
end

to step
  ;; FREE MOVING BUBBLES
  ask bubbles with [not growing-on-wall? and not stuck-on-wall? and not on-surface?] [
    ;    ask min-one-of other turtles in-radius (size / 2) [ who ] [ ;; min who so that we don't skip over any other turtles
    let nearby-turtles other turtles in-radius (size / 2)
    if any? other turtles in-radius (size / 2) [ ;; collision

      ask min-one-of nearby-turtles [ who ] [
        ifelse random-float 1 > 1 - chance-to-merge [
          resolve-merge

        ][
          ;; bounce
          resolve-bounce
        ]
      ]
    ]

    let percent-height max list ((zcor + max-pzcor) / (max-pzcor * 2)) 0 ;; if negative, ceil to 0
    set size (base-size * 5  * ((zcor + max-pzcor) * grow-effect / (max-pzcor * 2)))


    ;; for some variety
    let accel-percent random-float 0.2 + 0.6 ;; random float [0.9, 1.1]
    set z-acceleration (current-percent-pressure * accel-percent * ((zcor + max-pzcor) / (max-pzcor * 2)) / 30) ;; 30 ticks/second
    set z-speed (z-speed + z-acceleration)

    set x-acceleration min list (x-acceleration + random-float 0.0001 - 0.00005) 0.1
    set x-speed min list (x-speed + x-acceleration) 0.5

    set y-acceleration min list (y-acceleration + random-float 0.0001 - 0.00005) 0.1
    set y-speed min list (y-speed + y-acceleration) 0.5

    if (abs (xcor + x-speed)) > max-pxcor [ ;; assume min = -max coords
      set x-speed (x-speed * -1)
      set x-acceleration (x-acceleration * -1)
    ]

    if (abs (ycor + y-speed)) > max-pxcor [ ;; assume min = -max coords
      set y-speed (y-speed * -1)
      set y-acceleration (y-acceleration * -1)
    ]

    if (zcor + z-speed) > (max-pzcor - 0.5) [ initiate-surface-behaviour ]

    set xcor (xcor + x-speed)
    set ycor (ycor + y-speed)
    set zcor (zcor + z-speed)
  ]

  ;; BUBBLES MOVING ON THE WALL
  ask bubbles with [not growing-on-wall? and stuck-on-wall? and not on-surface?] [
    ;    ask min-one-of other turtles in-radius (size / 2) [ who ] [ ;; min who so that we don't skip over any other turtles
    let nearby-turtles other turtles in-radius (size / 2)
    if any? other turtles in-radius (size / 2) [ ;; collision

      ask min-one-of nearby-turtles [ who ] [
        ifelse random-float 1 > 1 - chance-to-merge [
          resolve-merge

        ][
          ;; bounce
          resolve-bounce
        ]
      ]
    ]

    let percent-height max list ((zcor + max-pzcor) / (max-pzcor * 2)) 0 ;; if negative, ceil to 0
    set size (base-size * 5  * ((zcor + max-pzcor) * grow-effect / (max-pzcor * 2)))

    ;; for some variety
    let accel-percent random-float 0.2 + 0.6 ;; random float [0.9, 1.1]
    set z-acceleration (current-percent-pressure * accel-percent * ((zcor + max-pzcor) / (max-pzcor * 2)) / 30) ;; 30 ticks/second
    set z-speed (z-speed + z-acceleration)

    if (zcor + z-speed) > (max-pzcor - 0.5) [ initiate-surface-behaviour ]

    set zcor (zcor + z-speed)
  ]

  ;; BUBBLES GROWING ON THE WALL
  ask bubbles with [growing-on-wall? and not on-surface?] [
    ;; transform [0, 1] -> [10, 0.1], essentially map x'->1-x and x''->10^(2x'-1)
    let positive-bias (10 ^ ((1 - adhesion-effect) * 2 - 1))
    ;; transform [0, 1] -> [0.2, 5], essentially map x'->10^(2x-1)
    let negative-bias (5 ^ ((current-percent-pressure) * 2 - 1))

    ;; decide if bubble will get unstuck based on growth
    ifelse growing-size  > base-size * (negative-bias + 1) [

      ;; check if ball will slide on the wall or go somewhere else
      ifelse (random-float 1 > 1 - dynamic-adhesion-effect) [
        set stuck-on-wall? true
      ] [
        set stuck-on-wall? false
      ]

      set base-size growing-size
      initiate-movement
    ] [

      ;; decide if bubble will get unstuck based on chance
      ifelse (random-float 1 * positive-bias > 0.5 ) [

        ;; check if ball will slide on the wall or go somewhere else
        ifelse (random-float 1 > 1 - dynamic-adhesion-effect) [
          set stuck-on-wall? true
        ] [
          set stuck-on-wall? false
        ]

        set base-size growing-size
        initiate-movement
      ]
      [
        ;; stay stuck and grow more
        set growing-size growing-size * 1.0005
        set size growing-size
      ]
    ]
  ]

  ;; BUBBLES ON THE SURFACE
  ask bubbles with [on-surface?] [
    set survival-factor (0.99 * survival-factor)

    if random-float 1 > resistance-to-popping * survival-factor [die]


    let nearby-turtles other turtles in-radius (size / 2)
    if any? other turtles in-radius (size / 2) [ ;; collision

      ask min-one-of nearby-turtles [ who ] [
        ifelse random-float 1 > 1 - chance-to-merge [
          resolve-merge

        ][
          ;; bounce
          resolve-bounce
        ]
      ]
    ]

    set x-acceleration min list (x-acceleration + random-float 0.0001 - 0.00005) 0.05
    set x-speed min (list (x-speed + x-acceleration) 0.25)

    set y-acceleration min list (y-acceleration + random-float 0.0001 - 0.00005) 0.05
    set y-speed min (list (y-speed + y-acceleration) 0.25)

    if (abs (xcor + x-speed)) > max-pxcor [ ;; assume min = -max coords
      set x-speed (x-speed * -1)
      set x-acceleration (x-acceleration * -1)
    ]

    if (abs (ycor + y-speed)) > max-pxcor [ ;; assume min = -max coords
      set y-speed (y-speed * -1)
      set y-acceleration (y-acceleration * -1)
    ]

    set xcor (xcor + x-speed)
    set ycor (ycor + y-speed)

  ]
end

to find-closest-turtles
  let min-distance 10000
  let closest-turtle nobody
  ask turtles [
    let closest nobody
    let closest-dist 10000

    ;; Compare this turtle to all other turtles
    ask other turtles [
      let dist distance myself
      if dist < closest-dist [
        set closest-dist dist
        set closest myself
      ]
    ]

    ;; Store the closest turtle and distance
    set closest-turtle closest
    set min-distance closest-dist
  ]

  ;; Now find the two turtles with the minimum distance overall
  let min-pair turtle 0
  let min-turtle-dist 1000

  ask turtles [
    if min-distance < min-turtle-dist [
      set min-turtle-dist min-distance
      set min-pair self
    ]
  ]

  ;; Highlight the two turtles that are closest together
  ask min-pair [
    watch-me
  ]
end
