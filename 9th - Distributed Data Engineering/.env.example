# Weather API Configuration
OPENWEATHER_API_KEY=YOUR_API_KEY_HERE
CITY_NAME=New York
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVER=kafka:29092
KAFKA_TOPIC_STATION_INFO=station_information
KAFKA_TOPIC_STATION_STATUS=station_status
KAFKA_TOPIC_WEATHER_DATA=weather_data

# PostgreSQL Configuration
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_DB=dde_database
POSTGRES_USER=dde_user
POSTGRES_PASSWORD=dde_password
POSTGRES_JDBC_URL=jdbc:postgresql://postgres_db:5432/dde_database

# Spark Configuration
SPARK_APP_NAME=DDE_Spark_Application
SPARK_MASTER=local[*]
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_CORES=2

# Processing Configuration
PRODUCER_INTERVAL=300
PROCESSING_INTERVAL=300
SPARK_STREAMING_BATCH_INTERVAL=10

# Monitoring Configuration
LOG_LEVEL=INFO
ENABLE_METRICS=true